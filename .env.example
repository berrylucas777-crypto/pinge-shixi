APP_URL=https://shixi.seu-link.fit
ALLOWED_HOSTS=shixi.seu-link.fit,127.0.0.1,localhost
APP_RELEASE=dev
SECRET_KEY=
DISABLE_DOCS=false
# 仅限本地验收；生产必须保持 false，直到接入真实支付回调。
ALLOW_SIMULATED_PAYMENT=false

# 内测人工核账：收款码地址可使用 /assets/pinpin-payment-qr.jpg 或已托管的 HTTPS 图片地址。
MANUAL_PAYMENT_ENABLED=false
MANUAL_PAYMENT_QR_URL=
MANUAL_PAYMENT_CONTACT=
PAYMENT_ADMIN_EMAILS=
# 留空时资料同步页沿用 PAYMENT_ADMIN_EMAILS；填写后仅这些邮箱可访问 /imports。
DATA_ADMIN_EMAILS=

# 0=周一 … 6=周日。默认只在周一、周三晚上匹配。
MATCH_HOUR=21
MATCH_WEEKDAYS=0,2
MATCH_ROUND_LIMIT=4
MATCH_POOL_MIN=2

# TypeSafe Jev（判断模型）。不配 key 时 21:00 仍用规则打分，不会调用外部模型。
JEV_API_KEY=
JEV_MODEL=jev-latest

# 阿里云邮件推送 DirectMail（触发邮件），不是企业邮
SMTP_HOST=smtpdm.aliyun.com
SMTP_PORT=465
SMTP_USER=no-reply@seu-link.fit
SMTP_PASSWORD=
SMTP_FROM=拼个实习 <no-reply@seu-link.fit>
SMTP_SSL=true
SMTP_REPLY_TO=1450616433@qq.com
